{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.aws/**)",
      "Read(~/.aws/**)",
      "Read(~/**/.env)",
      "Read(~/**/.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./.aws/**)",
      "Edit(~/.aws/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Read(~/.config/gh/**)",
      "Edit(~/.config/gh/**)"
    ],
    "ask": [
      "Bash(gh *)",
      "Bash(git push *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "excludedCommands": [
      "gh *",
      "git push *"
    ]
  }
}
