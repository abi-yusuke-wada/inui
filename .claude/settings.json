{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "blockWritesOutsideWorkingDirectories": true,
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/**/.env)",
      "Read(~/**/.env.*)",
      "Read(./.aws/**)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.npmrc)",
      "Read(~/.config/pnpm/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/gh/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.codex/auth.json)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(./.aws/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.config/gh/**)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review *--approve*)",
      "Bash(gh api *pulls/*/merge*)",
      "Bash(gh api graphql *mergePullRequest*)",
      "Bash(gh api graphql *enablePullRequestAutoMerge*)",
      "Bash(gh auth *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(gh ruleset *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push * main*)",
      "Bash(git push * :*)",
      "Bash(gh *.env*)",
      "Bash(gh *@.*)",
      "Bash(gh *@~*)",
      "Bash(gh *@/root*)",
      "Bash(gh *@/home*)",
      "Bash(gh *@/etc*)",
      "Bash(gh *@/mnt*)",
      "Bash(gh *--body-file*)",
      "Bash(gh *--input*)",
      "Bash(gh api *rulesets*)",
      "Bash(gh api *protection*)",
      "Bash(gh api *actions/secrets*)",
      "Bash(gh api *actions/variables*)",
      "Bash(gh api *actions/permissions*)",
      "Bash(gh api *-X DELETE*)",
      "Bash(gh api *--method DELETE*)",
      "Bash(gh api *-X PATCH repos/*/inui)",
      "Bash(gh api *-X PATCH repos/*/inui *)",
      "Bash(gh api *--method PATCH repos/*/inui)",
      "Bash(gh api *--method PATCH repos/*/inui *)"
    ],
    "ask": [
      "Bash(gh *)",
      "Bash(git push *)",
      "Bash(git -c * push*)",
      "Bash(git -C * push*)",
      "WebFetch"
    ]
  },
  "disableClaudeAiConnectors": true,
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "excludedCommands": [
      "gh *",
      "git push *"
    ],
    "credentials": {
      "envVars": [
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GH_ENTERPRISE_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITHUB_ENTERPRISE_TOKEN",
          "mode": "deny"
        },
        {
          "name": "AWS_ACCESS_KEY_ID",
          "mode": "deny"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "mode": "deny"
        },
        {
          "name": "AWS_SESSION_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NODE_AUTH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "OPENAI_API_KEY",
          "mode": "deny"
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "mode": "deny"
        },
        {
          "name": "TURSO_AUTH_TOKEN",
          "mode": "deny"
        }
      ]
    }
  }
}
