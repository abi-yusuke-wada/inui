{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "blockWritesOutsideWorkingDirectories": true,
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/**/.env)",
      "Read(~/**/.env.*)",
      "Read(./.aws/**)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.npmrc)",
      "Read(~/.config/pnpm/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/gh/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.codex/auth.json)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(./.aws/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.config/gh/**)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review *--approve*)",
      "Bash(gh api *pulls/*/merge*)",
      "Bash(gh api graphql *mergePullRequest*)",
      "Bash(gh api graphql *enablePullRequestAutoMerge*)",
      "Bash(gh auth *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(gh ruleset *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push * main*)",
      "Bash(git push * :*)",
      "Bash(gh *.env*)",
      "Bash(gh *@.*)",
      "Bash(gh *@~*)",
      "Bash(gh *@/root*)",
      "Bash(gh *@/home*)",
      "Bash(gh *@/etc*)",
      "Bash(gh *@/mnt*)",
      "Bash(gh *--body-file*)",
      "Bash(gh *--input*)"
    ],
    "ask": [
      "Bash(gh *)",
      "Bash(git push *)",
      "Bash(git -c * push*)",
      "Bash(git -C * push*)",
      "WebFetch"
    ]
  },
  "disableClaudeAiConnectors": true,
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "excludedCommands": [
      "gh *",
      "git push *"
    ]
  }
}
