{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.aws/**)",
      "Read(~/.aws/**)",
      "Read(~/**/.env)",
      "Read(~/**/.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./.aws/**)",
      "Edit(~/.aws/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true
  }
}
